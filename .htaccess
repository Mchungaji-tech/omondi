# ------------------------------------------------------------------------------
# 1. DEFAULT DIRECTORY INDEX
# Loads index.php automatically when accessing the root domain or directories
# ------------------------------------------------------------------------------
DirectoryIndex index.php index.html index.htm default.php

# ------------------------------------------------------------------------------
# 2. DISABLE DIRECTORY BROWSING
# Prevents server from showing a list of files (Index of /) instead of the website
# ------------------------------------------------------------------------------
Options -Indexes
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# ------------------------------------------------------------------------------
# 3. URL REWRITING & ROUTING
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Block direct browser access to sensitive files
    RewriteRule ^(\.env|\.git|\.cpanel\.ya?ml|schema\.sql)$ - [F,L,NC]

    # Clean URLs (e.g., /about opens about.php)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^\.]+)$ $1.php [NC,L]
</IfModule>

# ------------------------------------------------------------------------------
# 4. MIME TYPES & ENCODING
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js
    AddType image/svg+xml .svg
</IfModule>
